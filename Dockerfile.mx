# syntax=docker/dockerfile:1
#
# Dedicated image for the optional MX edge, used by the sidecar and remote
# deployments. The edge is pure Go with no cgo and opens no files, so it builds
# static and runs unprivileged. It needs ca-certificates (verified TLS to a
# remote core over HTTPS) and DNS (/etc/resolv.conf) for SPF/DKIM/DMARC.
#
# The embedded single-container mode (MX_ENABLE=true) does NOT use this image:
# it runs the edge binary that ships inside the main mailmoose image.

FROM golang:1.27-bookworm AS build
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mailmoose-mx ./dialmx/cmd/receiver

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/*

# The edge holds no /data, no app key and needs no privilege; it stages messages
# in memory. Run it as the same non-root uid the main image uses.
ARG MAILMOOSE_UID=65532
ARG MAILMOOSE_GID=65532
RUN groupadd -g ${MAILMOOSE_GID} mailmoose 2>/dev/null || true \
 && useradd -u ${MAILMOOSE_UID} -g ${MAILMOOSE_GID} -M -s /usr/sbin/nologin mailmoose

COPY --from=build /out/mailmoose-mx /usr/local/bin/mailmoose-mx
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/local/share/doc/mailmoose/
USER ${MAILMOOSE_UID}:${MAILMOOSE_GID}
EXPOSE 2525 8443
ENTRYPOINT ["/usr/local/bin/mailmoose-mx"]
