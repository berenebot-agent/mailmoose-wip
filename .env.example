# Required — startup fails without APP_ENCRYPTION_KEY (min 24 chars, back up separately from ./data)
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-24-characters
BASE_URL=https://mail.example.com

# Core — uncomment to override shown defaults
#DATA_DIR=/data
#MODE=selfhosted
#LISTEN_ADDR=:8081
# The dedicated inbound listener always runs on :8082 and is not configurable.
# It serves the webhook connectors and, when MX is enabled, the MX routes.
# Inbound provider secrets are no longer configured here: add a receive path per
# domain in the Admin UI (or PUT /v1/admin/domains/{id}/receiving). They are
# stored encrypted.
#ALLOW_REGISTRATION=false

# First-run Admin bootstrap — if set, the initial Admin setup form requires this
# one-time token so an arbitrary first internet visitor cannot claim the instance.
#ADMIN_BOOTSTRAP_TOKEN=

# Runtime user. A container boots as root only to chown a fresh ./data bind
# mount, then drops to this uid:gid before opening the database. Selects the
# runtime user for the app (and the app process in embedded MX mode).
# Leave unset to use 65532:65532, or set both to run ./data as your own user.
# A strict compose `user:` skips the boot chown and must own ./data itself.
#GATEHOUSE_RUN_UID=65532
#GATEHOUSE_RUN_GID=65532

# Trusted proxies — comma-separated IPs or CIDRs whose X-Forwarded-* headers are
# trusted (client IP, scheme). Leave empty to trust none. TRUST_PROXY_HEADERS=true
# is a legacy alias that trusts all peers.
#TRUSTED_PROXIES=10.0.0.0/8,192.168.1.0/24
#TRUST_PROXY_HEADERS=false

# Outbound SSRF guard. By default every outbound transport (HTTP provider API
# base and SMTP) must resolve to a public-routable destination. Set this to true
# only for self-hosted deployments that intentionally send through a private
# gateway or local relay; it is always ignored in MODE=hosted.
#ALLOW_PRIVATE_OUTBOUND=false

# Tuning — defaults from internal/config
#MAX_MESSAGE_BYTES=31457280
#DEFAULT_STORAGE_QUOTA_BYTES=104857600
#SESSION_TTL_HOURS=336
#RELAY_REQUIRE_CALLER_AUTH=false
#LOGIN_LIMIT_PER_MINUTE=10
#SEND_LIMIT_PER_MINUTE=60
# Signup attempts per source IP per minute (only relevant when ALLOW_REGISTRATION=true).
#REGISTER_LIMIT_PER_MINUTE=5
# External email approval validity window in hours (0 disables expiry).
#APPROVAL_EXPIRY_HOURS=48

# Inbound hardening
#INBOUND_CONCURRENCY=32
#MAX_MULTIPART_PARTS=64
#MAX_MIME_DEPTH=8
#MAX_MIME_PARTS=256
#BODY_READ_TIMEOUT_SECONDS=30

# --- Direct-SMTP (MX) ingress ------------------------------------------------
# One switch: MX_ENABLE. docker-compose.yml enables MX by default; the server
# binary itself defaults to false when MX_ENABLE is unset.
#   true             (compose default) receive on port 25 with the edge embedded
#                    in this container as a separate, unprivileged uid (no
#                    /data, no app key). The edge credential is generated
#                    automatically.
#   false            webhook-only: no MX and no listener on port 25. Set this if
#                    you receive mail only via Mailgun/Cloudflare/Resend.
#   remote           receive on port 25 with the edge in its own container/image
#                    (gatehouse-mx; docker-compose.mx-sidecar.yml) or on another
#                    host. Requires a shared MX_EDGE_SECRET.
# Then, in the Admin UI, set the domain's receiving provider to MX.
#MX_ENABLE=false
# Optional SMTP greeting hostname (defaults to gatehouse-mx).
#MX_HOSTNAME=mail.example.com
# Required for MX_ENABLE=remote: the shared edge secret (same value on the core
# and the edge container). Ignored by true (embedded), which generates its own.
#MX_EDGE_SECRET=replace-with-a-long-random-secret

# Advanced MX options (all optional; defaults from internal/config and
# internal/mxagent — set none to start).
# Embedded edge uid/gid, separate from the app runtime user (embedded mode).
#MX_UID=65533
#MX_GID=65533
# Override the generated credential to use custom or rotating keys.
#MX_EDGE_KEYS=edge-1:replace-with-a-long-random-secret
#MX_SIGNATURE_SKEW_SECONDS=600
#MX_RECEIPT_RETENTION_HOURS=168
#INBOUND_TLS_CERT_FILE=
#INBOUND_TLS_KEY_FILE=
# Edge (gatehouse-mx) — never give it the app .env; no APP_ENCRYPTION_KEY, no /data.
#MX_EDGE_KEY_ID=edge-1
#MX_EDGE_NAME=mx-1
#GATEHOUSE_INGEST_URL=http://gatehouse:8082
#MX_LISTEN_ADDR=:2525
# Offer STARTTLS when set together (opportunistic senders encrypt by default).
# Set MX_REQUIRE_TLS=true with these to refuse plaintext SMTP entirely (at the
# cost of bouncing senders that cannot do STARTTLS).
#MX_TLS_CERT=
#MX_TLS_KEY=
#MX_REQUIRE_TLS=false
#MX_VERIFY_SPF=true
#MX_VERIFY_DKIM=true
#MX_VERIFY_DMARC=true
#MX_DNS_RESOLVER=
#MX_DNS_TIMEOUT_SECONDS=10
#MX_MAX_MESSAGE_BYTES=31457280
# In-memory staging cap across concurrent transactions; a burst above it fails
# temporarily rather than risking an OOM kill.
#MX_STAGING_BYTES=268435456
#MX_MAX_RECIPIENTS=100
#MX_MAX_CONNECTIONS=256
#MX_READ_TIMEOUT_SECONDS=60
#MX_WRITE_TIMEOUT_SECONDS=60
#MX_DATA_TIMEOUT_SECONDS=300
# Optional health/readiness listener for the edge (/healthz, /readyz).
#MX_HEALTH_ADDR=:8090
