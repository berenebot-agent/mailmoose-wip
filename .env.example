# Required — startup fails without APP_ENCRYPTION_KEY (min 24 chars, back up separately from ./data)
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-24-characters
BASE_URL=https://mail.example.com

# Core — uncomment to override shown defaults
#DATA_DIR=/data
#MODE=selfhosted
#LISTEN_ADDR=:8081
# The inbound webhook-only listener always runs on :8082 and is not configurable.
# Inbound provider secrets are no longer configured here: add a receive path per
# domain in the Admin UI (or /v1/admin/inbound). They are stored encrypted.
#ALLOW_REGISTRATION=false

# First-run Admin bootstrap — if set, the initial Admin setup form requires this
# one-time token so an arbitrary first internet visitor cannot claim the instance.
#ADMIN_BOOTSTRAP_TOKEN=

# Runtime user. The container boots as root only to chown a fresh ./data bind
# mount, then drops to this uid:gid before opening the database. Leave unset to
# use 65532:65532, or set both to run ./data as your own user. A strict compose
# `user:` skips the boot chown and must own ./data itself.
#GATEHOUSE_RUN_UID=65532
#GATEHOUSE_RUN_GID=65532

# Trusted proxies — comma-separated IPs or CIDRs whose X-Forwarded-* headers are
# trusted (client IP, scheme). Leave empty to trust none. TRUST_PROXY_HEADERS=true
# is a legacy alias that trusts all peers.
#TRUSTED_PROXIES=10.0.0.0/8,192.168.1.0/24
#TRUST_PROXY_HEADERS=false

# Outbound SSRF guard. By default every outbound transport (HTTP provider API
# base and SMTP) must resolve to a public-routable destination. Set this to true
# only for self-hosted deployments that intentionally send through a private
# gateway or local relay; it is always ignored in MODE=hosted.
#ALLOW_PRIVATE_OUTBOUND=false

# Tuning — defaults from internal/config
#MAX_MESSAGE_BYTES=31457280
#DEFAULT_STORAGE_QUOTA_BYTES=104857600
#SESSION_TTL_HOURS=336
#RELAY_REQUIRE_CALLER_AUTH=false
#LOGIN_LIMIT_PER_MINUTE=10
#SEND_LIMIT_PER_MINUTE=60
# External email approval validity window in hours (0 disables expiry).
#APPROVAL_EXPIRY_HOURS=48

# Inbound hardening
#INBOUND_CONCURRENCY=32
#MAX_MULTIPART_PARTS=64
#MAX_MIME_DEPTH=8
#MAX_MIME_PARTS=256
#BODY_READ_TIMEOUT_SECONDS=30

# --- Optional direct-SMTP (MX) ingress ---------------------------------------
# App-only deployments leave MX off. To receive mail straight on port 25, set
# these three and run `docker compose --profile mx up -d`. Compose derives the
# edge credential from MX_EDGE_SECRET (core: edge-1:<secret>; edge: key id
# edge-1). Then set the domain's receiving provider to Gatehouse MX in the UI.
#MX_RECEIVE_ENABLED=true
#MX_EDGE_SECRET=replace-with-a-long-random-secret   # same value on both services
#MX_HOSTNAME=mail.example.com

# Advanced core MX options (optional; defaults shown — set none to start).
# Override the derived credential to use custom key ids or overlap keys for
# rotation.
#MX_EDGE_KEYS=edge-1:replace-with-a-long-random-secret
# How old a signed edge request may be (seconds).
#MX_SIGNATURE_SKEW_SECONDS=600
# Durable delivery-receipt retention; must cover the sender retry window.
#MX_RECEIPT_RETENTION_HOURS=168
# Optional inbound TLS so a remote MX edge can reach :8082 over verified TLS.
# Set both or neither; usually unnecessary behind a reverse proxy.
#INBOUND_TLS_CERT_FILE=
#INBOUND_TLS_KEY_FILE=

# Advanced MX edge options (optional; defaults shown — set none to start).
# These are read by the gatehouse-mx sidecar, not the app. Give the edge its own
# environment, never the app's .env: it holds no APP_ENCRYPTION_KEY and no /data.
#MX_EDGE_KEY_ID=edge-1
#MX_EDGE_NAME=mx-1
#GATEHOUSE_INGEST_URL=http://gatehouse-mail:8082
#MX_LISTEN_ADDR=:2525
#MX_STAGING_DIR=/staging
#MX_TLS_CERT=
#MX_TLS_KEY=
#MX_VERIFY_SPF=true
#MX_VERIFY_DKIM=true
#MX_VERIFY_DMARC=true
#MX_DNS_RESOLVER=
#MX_DNS_TIMEOUT_SECONDS=10
#MX_MAX_MESSAGE_BYTES=31457280
#MX_MAX_RECIPIENTS=100
#MX_MAX_CONNECTIONS=256
#MX_READ_TIMEOUT_SECONDS=60
#MX_WRITE_TIMEOUT_SECONDS=60
#MX_DATA_TIMEOUT_SECONDS=300
# Optional health/readiness listener for the edge (/healthz, /readyz).
#MX_HEALTH_ADDR=:8090
