# Copy to .env and fill in. Everything here is per-installation.
#
# LLM provider the Gateway's agent turns run against. Any OpenAI-compatible
# endpoint works; provider id must match `models.providers.<id>` in state/openclaw.json.
TILLER_API_KEY=

# Optional: override the model if you point at a different provider.
# OPENCLAW_TEST_MODEL=tiller/main/hermes-daily
