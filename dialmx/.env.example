# Example environment for the standalone Dial MX receiver (dialmx/compose.yml).
# Copy to dialmx/.env and adjust. The receiver holds no database, no /data
# and no APP_ENCRYPTION_KEY. Single mode shares a bearer key with its core.
DIALMX_MODE=single
DIALMX_CORE_KEY=replace-with-openssl-rand-hex-32-output

# SMTP greeting hostname. Independent of the session listener address. Point the
# receiving domain's MX record at a hostname that resolves to this receiver.
MX_HOSTNAME=mail.example.com

# Optional: a browser visiting the receiver root is 302-redirected here. Must be
# an https URL with no fragment. API, health and session routes are unchanged.
#DIALMX_BROWSER_REDIRECT_URL=https://github.com/dellarb/mailmoose

# Directory holding the receiver's TLS material, mounted read-only at /certs.
# compose.yml maps host :25 -> container :2525 (SMTP) and :443 -> :8443 (HTTPS/2).
#DIALMX_CERT_DIR=./certs

# The session listener certificate pair. Optional in single mode, required in
# shared mode. Both absent selects cleartext HTTP/2.
#DIALMX_TLS_CERT=/certs/fullchain.pem
#DIALMX_TLS_KEY=/certs/privkey.pem

# Optional SMTP STARTTLS pair, independent of the session certificates.
#MX_TLS_CERT=/certs/fullchain.pem
#MX_TLS_KEY=/certs/privkey.pem
#MX_REQUIRE_TLS=false

# Evidence classes the edge computes on the original bytes.
MX_VERIFY_SPF=true
MX_VERIFY_DKIM=true
MX_VERIFY_DMARC=true

# Resolver for SPF/DKIM/DMARC and the _mailmoose-mx TXT proof. Empty uses the
# system resolver.
#MX_DNS_RESOLVER=1.1.1.1:53

# Bounds (defaults match the core's embedded MX edge; set none to start).
#MX_MAX_MESSAGE_BYTES=31457280
#MX_STAGING_BYTES=268435456
#MX_MAX_RECIPIENTS=100
#MX_MAX_CONNECTIONS=256
#MX_MAX_TRANSACTIONS=128
#MX_MAX_DOMAINS_PER_CONNECTION=128
#MX_MAX_TRANSACTIONS_PER_CONNECTION=16
#MX_MAX_TRANSACTIONS_PER_DOMAIN=8
#MX_AUTH_TIMEOUT_SECONDS=10
#MX_RESOLVE_TIMEOUT_SECONDS=10
#MX_INGEST_TIMEOUT_SECONDS=180
#MX_REVALIDATE_SECONDS=240
